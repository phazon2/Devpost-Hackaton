{
  "name": "doorman",
  "version": "0.1.0",
  "private": true,
  "description": "Your suppliers don't have a company domain. So give them one of yours.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "mock": "tsx src/mock/server.ts",
    "probe": "tsx scripts/probe.ts",
    "probe:mock": "DOORMAN_ALLOW_MOCK_PROBE=1 NAMECOM_BASE=http://127.0.0.1:8787 NAMECOM_USER=demo-test NAMECOM_TOKEN=mock-token tsx scripts/probe.ts",
    "edge-cases": "tsx scripts/edge-cases.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^11.7.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.2",
    "@types/better-sqlite3": "^7.6.12"
  }
}
