# Copy to .env and fill in. .env is gitignored — never commit it.
# Gate 0.2: tokens come from name.com -> Settings -> Security -> API Tokens.

# SANDBOX (build against this exclusively)
NAMECOM_BASE=https://api.dev.name.com
# Sandbox quirk: append -test to your username
NAMECOM_USER=yourusername-test
NAMECOM_TOKEN=

# The buyer's anchor domain, created in the sandbox first.
ANCHOR_DOMAIN=

# Public URL of this app (required by the name.com webhook receiver).
PUBLIC_BASE_URL=
PORT=8080
